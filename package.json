{
  "name": "typing-language-learning",
  "private": true,
  "version": "0.34.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "validate": "node scripts/validate-sentences.mjs && node scripts/content-validate.mjs",
    "content:extract": "node scripts/content-extract.mjs",
    "content:build": "node scripts/content-build.mjs",
    "content:validate": "node scripts/content-validate.mjs",
    "content:sqlite": "node scripts/content-sqlite.mjs",
    "check:content": "node scripts/check-content-sqlite.mjs",
    "prebuild": "node scripts/content-build.mjs && node scripts/content-sqlite.mjs && node scripts/gen-miss-sound.mjs",
    "postbuild": "node scripts/gen-404.mjs && node scripts/gen-precache.mjs",
    "predev": "node scripts/content-build.mjs && node scripts/content-sqlite.mjs && node scripts/gen-miss-sound.mjs",
    "gen-miss-sound": "node scripts/gen-miss-sound.mjs",
    "prevalidate": "node scripts/content-build.mjs",
    "pretest": "node scripts/content-build.mjs",
    "precoverage": "node scripts/content-build.mjs",
    "add-words": "node scripts/add-words.mjs",
    "gen-gloss": "node scripts/gen-gloss.mjs",
    "gen-sentences": "node scripts/gen-sentences.mjs",
    "merge-sentences": "node scripts/merge-sentences.mjs",
    "gen-wsent-theme": "node scripts/gen-wsent-theme.mjs",
    "claude:doc-researcher": "bash scripts/claude/doc-researcher/run.sh",
    "gen-dict": "node scripts/gen-dict.mjs",
    "merge-dict": "node scripts/merge-dict.mjs",
    "check-readings": "node scripts/check-readings.mjs",
    "build:pkgs": "npm run -w @tll/ui build",
    "check": "npm run lint && npm run coverage && npm run validate && npm run build:pkgs && npm run build && npm run check:content && npm run check-bundle && npm run audit",
    "check:fast": "npm run lint && npm run test && npm run validate && npm run build:pkgs && npm run build && npm run check-bundle",
    "check:ci": "bash scripts/check-ci.sh",
    "check-bundle": "node scripts/check-bundle.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "push-selfcheck": "node scripts/push-selfcheck.mjs",
    "versus:e2e": "node scripts/versus-e2e.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "screenshots": "node scripts/screenshots.mjs",
    "shots:play": "node scripts/shots-play.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "team": "node scripts/team-show.mjs",
    "team:set": "node scripts/team-set.mjs",
    "team:test": "node --test scripts/team-ledger.test.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/react-vite": "^10.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "puppeteer-core": "^25.3.0",
    "storybook": "^10.4.6",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
